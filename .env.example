# ============================================================
# InvoiceIQ - Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# ============================================================

# --- AWS Configuration ---

# AWS region for all services (e.g., eu-west-2)
AWS_REGION=eu-west-2

# AWS account ID (used for CDK deployment and resource naming)
AWS_ACCOUNT_ID=

# --- DynamoDB ---

# Main table name (created by CDK StorageStack)
DYNAMODB_TABLE_NAME=invoiceiq-dev-main

# --- S3 ---

# Documents bucket name (created by CDK StorageStack)
S3_DOCUMENTS_BUCKET=invoiceiq-dev-documents

# SPA hosting bucket name (created by CDK StorageStack)
S3_SPA_BUCKET=invoiceiq-dev-spa

# --- Cognito ---

# Cognito User Pool ID (created by CDK or manually)
COGNITO_USER_POOL_ID=

# Cognito App Client ID
COGNITO_CLIENT_ID=

# Cognito App Client Secret (optional, depends on client config)
COGNITO_CLIENT_SECRET=

# --- Bedrock ---

# Bedrock model ID for normalisation and recommendation
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0

# --- CDK Context ---

# Deployment stage (dev, staging, prod)
STAGE=dev

# Alert email for budget and alarm notifications
ALERT_EMAIL=team@example.com

# Daily Textract spend limit in USD (CloudWatch alarm threshold)
TEXTRACT_DAILY_LIMIT=5

# Daily Bedrock spend limit in USD (CloudWatch alarm threshold)
BEDROCK_DAILY_LIMIT=10

# --- Frontend (Vite) ---
# These are prefixed with VITE_ so Vite exposes them to the client bundle.

# API base URL (API Gateway endpoint after deployment)
VITE_API_URL=http://localhost:3001

# Cognito User Pool ID (for frontend auth)
VITE_COGNITO_USER_POOL_ID=

# Cognito App Client ID (for frontend auth)
VITE_COGNITO_CLIENT_ID=

# Cognito domain (for hosted UI, if used)
VITE_COGNITO_DOMAIN=

# --- Local Development ---

# Port for the local API server (Express wrapper around Lambda handlers)
API_PORT=3001

# Port for the Vite dev server
WEB_PORT=5173
